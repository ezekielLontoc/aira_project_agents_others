# ============================================================
# AIRA Docker Runtime Environment
# Copy to .env for local use.
# Do not commit real secrets.
# ============================================================

AIRA_POSTGRES_DB=aira_platform
AIRA_POSTGRES_USER=aira_admin
AIRA_POSTGRES_PASSWORD=aira_local_password_change_me

AIRA_API_PORT=9090
AIRA_SECURITY_PORT=9091
AIRA_GOVERNANCE_PORT=9092
AIRA_EVIDENCE_PORT=9093
AIRA_AGENTS_PORT=9094
AIRA_OBSERVABILITY_PORT=9095

SPRING_PROFILES_ACTIVE=default